# ============================================
# Aura 统一忽略规则（根目录单份）
# 覆盖：前端(Vite/Vue) + 后端(Java/Maven) + AI(Python) + 项目级
# ============================================

# ---------- WorkBuddy 工作区数据（仅本机保留，不入库） ----------
.workbuddy/

# ---------- 运行日志 ----------
logs/
*.log
*.log.*

# ---------- 前端 (Aura-frontend / Vite / Node) ----------
node_modules/
dist/
dist-ssr/
*.local
.env.local
.env.*.local

# ---------- Java 后端 (Aura-backend-server / Maven) ----------
HELP.md
target/
.mvn/wrapper/maven-wrapper.jar

# 本地配置（含数据库密码等敏感信息，仅本机保留）
**/src/main/resources/application.yaml

### STS ###
.apt_generated
.classpath
.factorypath
.project
.settings
.springBeans
.sts4-cache

### NetBeans ###
/nbproject/private/
/nbbuild/
/nbdist/
/.nb-gradle/
build/

# ---------- Python AI 服务 (Aura-backend-ai) ----------
__pycache__/
*.pyc
.venv/

# 环境变量文件（保留模板示例）
.env
!.env.example

# ---------- IDE / 编辑器 ----------
### IntelliJ IDEA ###
.idea/
*.iws
*.iml
*.ipr

### VS Code ###
.vscode/*
!.vscode/extensions.json

# ---------- 运行时数据（本机产生，不入库） ----------
# 向量缓存：CacheBackedEmbeddings 的 LocalFileStore 落盘目录（不是单文件）
embedding_cache.db/
**/embedding_cache.db/

# 用户上传文件与临时图片：头像、团队 logo、知识库文档、对话中的临时图
# 这些由运行期写入，换机后应为空目录
Aura-backend-server/docs/
uploads/
temp_images/

# 嵌入式数据库 / 向量索引等本地数据文件
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.faiss
chroma_db/
milvus_data/
volumes/

# 测试与类型检查缓存
.pytest_cache/
.mypy_cache/
.ruff_cache/

# JVM 崩溃转储与堆快照
hs_err_pid*.log
replay_pid*.log
*.hprof

# ---------- 系统文件 ----------
.DS_Store
Thumbs.db
desktop.ini
