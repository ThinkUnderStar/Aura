# =====================================================================
# Aura-backend-ai 环境变量样板文件（用于提交到 Git）
# 使用方式：复制本文件为 .env，并填入真实的密钥与账号密码。
#   cp .env.example .env
# 注意：真实的 .env 已被 .gitignore 忽略，请勿提交到仓库。
# =====================================================================

# ==================== MySQL 数据库配置 ====================
MYSQL_USER=root
MYSQL_PASSWORD=YOUR_MYSQL_PASSWORD   # TODO: 改为你的 MySQL 密码
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=aura

# ==================== Milvus 向量数据库配置 ====================
# 注：MILVUS_URI / MILVUS_TOKEN / MILVUS_DB_NAME 未写在此处，使用 config.py 中的默认值：
#     URI=localhost:19530  TOKEN=root:Milvus  DB=aura
MILVUS_DIMENSION=2560

# ==================== PostgreSql 向量数据库配置 ====================
# TODO: 将 your_postgres_password 改为你的 PostgreSQL 密码（含特殊字符时需 URL 编码）
POSTGRES_URL=postgresql://postgres:your_postgres_password@localhost:5432/aura_agent_memory?sslmode=disable

# ==================== 文档存储路径配置 ====================
DOCUMENT_ROOT=../Aura-backend-server/docs

# ==================== 文档处理配置 ====================
SPLIT_CHUNK_SIZE=512
SPLIT_CHUNK_OVERLAP=64

# ==================== 本地嵌入模型（Ollama） ====================
EMBEDDING_MODEL=qwen3-embedding:4b

# ==================== ComfyUI AI 生图配置 ====================
COMFYUI_HOST=127.0.0.1:8488
COMFYUI_WORKFLOW=workflow_api.json
COMFYUI_SAVE_PATH=../Aura-backend-server/docs/temp_images

# ==================== RAG 流程 - 各环节模型配置 ====================
MULTI_QUERY_MODEL=llama3.2:3b
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
EXTRACTOR_MODEL=qwen2.5:3b

# ======================= 用户交互模型 =======================
CHAT_MODEL_NAME=deepseek-v4-flash
CHAT_MODEL_API_KEY=YOUR_CHAT_MODEL_API_KEY   # TODO: 改为你的模型 API Key
CHAT_MODEL_BASE_URL=https://api.deepseek.com
CHAT_MODEL_TEMPERATURE=0.7

# ======================= Tavily 配置 =========================
TAVILY_API_KEY=YOUR_TAVILY_API_KEY   # TODO: 改为你的 Tavily API Key

#============设置为环境变量（可选），将Hugging Face的模型设置为离线模式=====================
HF_HUB_OFFLINE=1
